# Solo para trabajar en tu ordenador. En GitHub Codespaces la clave va en el secret GEMINI_API_KEY.
# Copia este fichero como .env (nunca subas .env a GitHub: ya está en .gitignore).

GEMINI_API_KEY=pega-aqui-tu-clave

# Opcional
# MODELO=gemini-3.5-flash-lite      # alternativa con cuota propia: gemini-3.1-flash-lite
# MAX_RPM=9                         # llamadas por minuto (el plan gratuito permite 10)
# MODO_LLM=auto                     # auto | live | replay | record

# Para usar otro proveedor compatible con OpenAI (Azure OpenAI, OpenAI, Ollama, LM Studio...)
# PROVEEDOR=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODELO=llama3.2
